{
  "permissions": {
    "allow": []
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/Library/Sounds/CardAccepted.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/Library/Sounds/CardAccepted.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccusage@latest statusline --visual-burn-rate emoji"
  },
  "enabledPlugins": {
    "my-first-plugin@test-marketplace": false,
    "zenn-articles@jobaria-claude-marketplace": false,
    "notion-mcp@competency-cloud-marketplace": true,
    "github-mcp@competency-cloud-marketplace": true,
    "context7-mcp@competency-cloud-marketplace": true,
    "playwright-mcp@competency-cloud-marketplace": true,
    "figma-mcp@competency-cloud-marketplace": true,
    "notion-ticket@competency-cloud-marketplace": true,
    "setup-serena-mcp@competency-cloud-marketplace": true,
    "commit@competency-cloud-marketplace": true,
    "plugin-dev@competency-cloud-marketplace": true
  }
}
